# Build from the repo root:  docker build -f docker/Dockerfile.api -t stroke-api .
FROM python:3.10-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY api/ ./api/
COPY scripts/ ./scripts/
COPY data/ ./data/

# The model artifact is gitignored, so train it into the image at build time.
RUN python scripts/train.py --model xgb --output models/model.pkl

EXPOSE 8000

CMD ["uvicorn", "api.app:app", "--host", "0.0.0.0", "--port", "8000"]
