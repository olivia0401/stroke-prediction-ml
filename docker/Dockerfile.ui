# Build from the repo root:  docker build -f docker/Dockerfile.ui -t stroke-ui .
FROM python:3.10-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY scripts/ ./scripts/
COPY data/ ./data/
COPY app_ui.py .

# The model artifact is gitignored, so train it into the image at build time.
RUN python scripts/train.py --model xgb --output models/model.pkl

EXPOSE 7860

CMD ["python", "app_ui.py"]
