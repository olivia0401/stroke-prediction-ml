FROM python:3.10-slim

WORKDIR /app

# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY src/ ./src/
COPY ui/ ./ui/
COPY models/ ./models/

# Expose Gradio port
EXPOSE 7860

# Run Gradio
CMD ["python", "ui/gradio_app.py"]
